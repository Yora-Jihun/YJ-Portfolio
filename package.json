{
    "name": "yj-portfolio",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/build-blog.mjs && concurrently -k -n posts,build,serve -c yellow,blue,green \"node scripts/build-blog.mjs --watch\" \"vite build --watch\" \"vite --open\"",
        "start": "npm run dev",
        "build:blog": "node scripts/build-blog.mjs",
        "build": "node scripts/build-blog.mjs && vite build",
        "watch": "vite build --watch"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.5",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "alpinejs": "^3.16.3",
        "marked": "^18.0.14"
    }
}
